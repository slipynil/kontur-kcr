# Шаблон окружения dev-сервера.
# Скопируйте на сервере: cp server/.env.example server/.env
# и замените все change-me. Файл server/.env не коммитится (.gitignore).

# --- Образы GHCR -----------------------------------------------------------
# Владелец образов и тег. IMAGE_TAG=latest — обычный деплой;
# для откката укажите SHA-тег коммита (см. server/README.md).
GHCR_OWNER=slipynil
IMAGE_TAG=latest

# --- Хостовые порты (настраиваются, не статические) -------------------------
# Фронтенд: контейнер слушает 3000, наружу сейчас публикуем на 80.
FRONTEND_HOST_PORT=80
# Gateway: контейнер слушает 8080, наружу по умолчанию 8080.
GATEWAY_HOST_PORT=8080

# --- Прокси API во frontend -------------------------------------------------
# Имя сервиса и внутренний порт в сети compose.
# После изменения пересоздайте frontend-контейнер.
GATEWAY_INTERNAL_URL=http://gateway:8080

# --- Gateway / Identity -----------------------------------------------------
# Замените change-me случайным секретом длиной не менее 32 символов.
JWT_SECRET=change-me
JWT_TTL=8h
# Разрешённые источники для браузерных запросов к API (через запятую).
CORS_ALLOWED_ORIGINS=http://176.109.100.140
UPSTREAM_TIMEOUT=30s

IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=change-me
IDENTITY_DB_NAME=identity

# --- Clients ----------------------------------------------------------------
CLIENTS_DB_USER=clients
CLIENTS_DB_PASSWORD=change-me
CLIENTS_DB_NAME=clients

# --- Import (БД, RabbitMQ) ---------------------------------------------------
IMPORT_DB_USER=import_user
IMPORT_DB_PASSWORD=change-me
IMPORT_DB_NAME=import_db
IMPORT_RABBITMQ_USER=import_user
IMPORT_RABBITMQ_PASSWORD=change-me
IMPORT_MAX_UPLOAD_BYTES=33554432
# Consumer применяет импорт в Clients Service внутри docker-сети.
IMPORT_LOCAL_CLIENTS_URL=http://clients:8000

# --- Operator Work -----------------------------------------------------------
OPERATOR_WORK_DB_USER=operator_work
OPERATOR_WORK_DB_PASSWORD=change-me
OPERATOR_WORK_DB_NAME=operator_work
OPERATOR_WORK_SERVICE_TOKEN=change-me
OPERATOR_WORK_CLIENTS_URL=http://clients:8000
