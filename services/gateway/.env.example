# Gateway / Identity local configuration.
# Real environment variables take precedence over this file (viper AutomaticEnv).
# Port conventions: docs/local-development.md.

# Port the gateway listens on.
GATEWAY_PORT=8080
GATEWAY_DEBUG=false

# Identity DB (docker compose publishes identity-db on 127.0.0.1:5432).
IDENTITY_DSN=postgres://identity:identity@127.0.0.1:5432/identity?sslmode=disable

# JWT signing secret; MUST be set, >= 32 characters. Generate e.g.:
#   openssl rand -hex 32
JWT_SECRET=
# Token time to live.
JWT_TTL=8h

# Comma-separated allowed CORS origins ("*" to allow all).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Timeout waiting for an internal service response.
UPSTREAM_TIMEOUT=30s

# Python services, local host ports (docs/local-development.md).
CLIENTS_ENDPOINT=http://127.0.0.1:8001
IMPORT_API_ENDPOINT=http://127.0.0.1:8002
OPERATOR_WORK_ENDPOINT=http://127.0.0.1:8003
ASSISTANT_ENDPOINT=http://127.0.0.1:8004
