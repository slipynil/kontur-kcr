# Gateway / Identity local configuration.
# Endpoints point to the host ports of local Docker Compose deployments
# (see docs/local-development.md for the port table).

# Port the gateway listens on.
GATEWAY_PORT=8080
GATEWAY_DEBUG=false

# Python services, local host ports.
CLIENTS_ENDPOINT=http://127.0.0.1:8001
IMPORT_API_ENDPOINT=http://127.0.0.1:8002
OPERATOR_WORK_ENDPOINT=http://127.0.0.1:8003
ASSISTANT_ENDPOINT=http://127.0.0.1:8004
