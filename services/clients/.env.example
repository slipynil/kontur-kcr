# Local Docker Compose only. Do not use these example credentials on a shared stand.
CLIENTS_DATABASE_URL=postgresql+psycopg://clients:clients_local@localhost:5433/clients
# Leave disabled on shared stands until service authentication is agreed.
CLIENTS_ENABLE_IMPORT_APPLY=false
CLIENTS_ENABLE_REGISTRY_READ=false
CLIENTS_ENABLE_DATA_RECOVERY=false

# Port the container listens on (uvicorn). Defaults to 8000, the contract
# from docs/api/internal/clients-service.yaml.
CLIENTS_PORT=8000
# Host port for local access; 8001 avoids clashing with the other services.
# Gateway .env points here: CLIENTS_ENDPOINT=http://127.0.0.1:8001
CLIENTS_HOST_PORT=8001
