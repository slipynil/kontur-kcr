# Local Docker Compose only. Do not use these example credentials on a shared stand.
IMPORT_POSTGRES_PASSWORD=import-dev
IMPORT_RABBITMQ_USER=import_user
IMPORT_RABBITMQ_PASSWORD=import-dev
IMPORT_MAX_UPLOAD_BYTES=33554432

# Port the API container listens on (uvicorn). Defaults to 8000, the contract
# from docs/api/internal/import-worker.yaml.
IMPORT_API_PORT=8000
# Host port for local access; 8002 avoids clashing with the other services.
# Gateway .env points here: IMPORT_API_ENDPOINT=http://127.0.0.1:8002
IMPORT_API_HOST_PORT=8002
