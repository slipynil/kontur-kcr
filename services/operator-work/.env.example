# Local Docker Compose only. Do not use these example credentials on a shared stand.
OPERATOR_WORK_SERVICE_TOKEN=local-dev-service-token
# Optional. Must be reachable from the API container (127.0.0.1 will NOT work
# there); see README. Without it overdue cycles stay out of the pool.
#OPERATOR_WORK_CLIENTS_URL=http://clients.internal:8000

# Port the container listens on (uvicorn). Defaults to 8000, the contract
# from docs/api/internal/operator-work-service.yaml.
OPERATOR_WORK_PORT=8000
# Host port for local access; 8003 avoids clashing with the other services.
# Gateway .env points here: OPERATOR_WORK_ENDPOINT=http://127.0.0.1:8003
OPERATOR_WORK_HOST_PORT=8003
