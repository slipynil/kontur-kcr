# Local Docker Compose only. Do not use these example credentials on a shared stand.
CLIENT_HISTORY_POSTGRES_PASSWORD=client-history-dev

# Optional. Base URLs reachable from the API container (127.0.0.1 will NOT work
# there); see README. Without the Gateway a batch with an unnamed author is not
# accepted; without Clients a code without records always reads as an empty page.
#CLIENT_HISTORY_GATEWAY_URL=http://host.docker.internal:8080
#CLIENT_HISTORY_CLIENTS_URL=http://host.docker.internal:8001

# Port the container listens on (uvicorn). Defaults to 8000, the contract
# from docs/api/internal/client-history.yaml.
CLIENT_HISTORY_PORT=8000
# Host port for local access; 8005 avoids clashing with the other services.
# Gateway .env points here: CLIENT_HISTORY_ENDPOINT=http://127.0.0.1:8005
CLIENT_HISTORY_HOST_PORT=8005
